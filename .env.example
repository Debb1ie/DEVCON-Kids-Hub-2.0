# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Edge Function secrets (set with `supabase secrets set`; never expose as VITE_* values)
# MISTRAL_API_KEY=server-only-mistral-key
# MISTRAL_CHAT_MODEL=mistral-small-latest
# GROQ_API_KEY=server-only-groq-key
# GROQ_CHAT_MODEL=openai/gpt-oss-20b
# SUPABASE_SERVICE_ROLE_KEY=server-only-service-role-key
# GOOGLE_OAUTH_CLIENT_ID=google-oauth-web-client-id
# GOOGLE_OAUTH_CLIENT_SECRET=server-only-google-oauth-client-secret
# GOOGLE_OAUTH_REDIRECT_URI=https://your-project.supabase.co/functions/v1/google-workspace-auth
# GOOGLE_OAUTH_TOKEN_ENCRYPTION_KEY=base64-encoded-32-byte-key
